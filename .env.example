# JobFlow AI — frontend environment template.
#
# Copy to `.env.local` for development, or set these in the Vercel dashboard
# for production. Only NEXT_PUBLIC_* values reach the browser bundle, so
# nothing secret belongs here — the API key, database URL and R2 credentials
# all live in the backend repo's .env.
#
# IMPORTANT: these are read at BUILD time on Vercel. Changing one requires a
# redeploy, not just a restart.

# Base URL of the Laravel API — no trailing slash, no /api/v1 suffix.
# Local:  http://localhost:8000
# Prod:   https://jobflow-api.onrender.com
# Required in production: the build fails fast if this is missing, rather than
# silently shipping a bundle that calls localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this app. Used for absolute links and OG metadata.
# Prod:   https://jobflow-ai.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laravel Reverb public key. Leave empty to run without websockets
# (the app falls back to polling). Not required for the first deploy.
NEXT_PUBLIC_REVERB_KEY=

# Explicit feature allow-list, comma-separated. Unfinished surfaces stay
# hidden rather than faked. Leave empty to enable everything built so far.
# Example: job_board,capture_pdf,capture_image,capture_url
NEXT_PUBLIC_FEATURES=
