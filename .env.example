# Copy to .env.local and adjust. Only NEXT_PUBLIC_* values are exposed to the browser.

# Base URL of the Laravel API (no trailing slash, no /api/v1 suffix).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this app (used for absolute links and OG metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laravel Reverb public key. Leave empty to run without websockets (polling fallback).
NEXT_PUBLIC_REVERB_KEY=

# Explicit feature allow-list. Unfinished surfaces stay hidden instead of faked.
# Later phases add: job_board,capture_pdf,capture_image,capture_url,career_assistant
NEXT_PUBLIC_FEATURES=
